{
  "name": "@tilfin/flatout",
  "version": "0.10.11",
  "author": "Toshimitsu Takahashi",
  "license": "MIT",
  "description": "Lightweight Single-Page-Application framework for JavaScript",
  "type": "module",
  "main": "dist/flatout.js",
  "types": "dist/flatout.d.ts",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "lint": "biome check src/** spec/**",
    "test": "mocha --timeout 15000 test/client/**.test.js",
    "coverage": "nyc report --reporter=html",
    "debug": "node test/inner_debug.js",
    "dist": "./bin/dist.sh",
    "doc": "esdoc",
    "example": "node examples/server.js ."
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:tilfin/flatout.git"
  },
  "keywords": [
    "view",
    "framework",
    "SPA"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.2.1",
    "@rollup/plugin-strip": "^1.3.3",
    "@rollup/plugin-terser": "^0.4.4",
    "chai": "^6.2.0",
    "chai-spies": "^1.1.0",
    "esdoc": "^1.1.0",
    "esdoc-ecmascript-proposal-plugin": "^1.0.0",
    "esdoc-standard-plugin": "^1.0.0",
    "fastify": "^5.6.1",
    "mocha": "^11.7.4",
    "nyc": "^17.1.0",
    "puppeteer": "^24.24.0",
    "puppeteer-to-istanbul": "^1.4.0",
    "rollup": "^4.52.4",
    "rollup-plugin-sourcemaps": "^0.6.3"
  }
}
